<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trabajos publicados — HiPortafolio</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<style>body{background:#0b1220;color:#e5edf8;font-family:system-ui,sans-serif}.top{padding:28px 0;border-bottom:1px solid #263247;background:#101a2b}.brand{color:#a3ff70;font-weight:800;letter-spacing:2px;text-decoration:none}.card-work{height:100%;background:#111d30;border:1px solid #29384f;border-radius:14px;color:#e5edf8}.muted{color:#9aabc2}.btn-green{background:#a3ff70;color:#101a2b;font-weight:700;border:0}.btn-green:hover{background:#c1ff9e;color:#101a2b}.pill{background:#203148;color:#bde4ff;border-radius:20px;padding:5px 10px;font-size:.8rem}</style></head><body>
<header class="top"><div class="container d-flex justify-content-between align-items-center flex-wrap gap-3"><a class="brand" href="${pageContext.request.contextPath}/portafolio">HIPORTAFOLIO</a><nav class="d-flex gap-3"><a class="link-light" href="${pageContext.request.contextPath}/portafolio">Inicio</a><a class="link-light" href="${pageContext.request.contextPath}/proyectos">Proyectos</a><a class="link-light" href="${pageContext.request.contextPath}/evidencias">Evidencias</a></nav></div></header>
<main class="container py-5"><div class="mb-4"><span class="pill">PORTAFOLIO PÚBLICO</span><h1 class="display-5 fw-bold mt-3">Trabajos y archivos</h1><p class="muted">Aquí puedes consultar y descargar los documentos, informes, imágenes y trabajos que se han publicado.</p></div>
<c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if>
<div class="row g-4"><c:forEach var="a" items="${archivos}"><div class="col-12 col-md-6 col-lg-4"><article class="card card-work"><div class="card-body p-4 d-flex flex-column"><div class="fs-2 mb-3" style="color:#a3ff70"><i class="bi bi-file-earmark-text"></i></div><h2 class="h5">${a.nombreOriginal}</h2><p class="muted small mb-3">${a.tipoMime} · ${a.tamanoFormateado}</p><p class="muted small">Publicado por: <c:out value="${a.nombreUsuario}" default="Administrador"/></p><div class="mt-auto d-flex gap-2 pt-3"><a class="btn btn-green" target="_blank" rel="noopener" href="${pageContext.request.contextPath}/archivos/ver?id=${a.idArchivo}"><i class="bi bi-eye me-1"></i>Ver</a><a class="btn btn-outline-light" href="${pageContext.request.contextPath}/archivos/descargar?id=${a.idArchivo}"><i class="bi bi-download me-1"></i>Descargar</a></div></div></article></div></c:forEach>
<c:if test="${empty archivos}"><div class="col-12"><div class="text-center p-5 rounded-4" style="border:1px dashed #40516a"><i class="bi bi-folder2-open fs-1 muted"></i><h2 class="h4 mt-3">Todavía no hay trabajos publicados</h2><p class="muted mb-0">Cuando el administrador suba archivos desde el panel, aparecerán aquí.</p></div></div></c:if></div></main><footer class="container py-4 muted small">© HiPortafolio · Trabajos publicados</footer></body></html>
